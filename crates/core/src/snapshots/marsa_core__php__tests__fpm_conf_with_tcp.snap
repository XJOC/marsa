---
source: crates/core/src/php.rs
expression: text
---
; Managed by Marsa. Changes to this file are overwritten.
[global]
error_log = "/marsa/logs/php-8.4-fpm.log"
daemonize = no

[marsa]
listen = 127.0.0.1:9084
pm = ondemand
pm.max_children = 10
pm.process_idle_timeout = 30s
pm.max_requests = 500
catch_workers_output = yes
decorate_workers_output = no
clear_env = yes
env[PATH] = "/marsa/shims:/usr/bin:/bin:/usr/sbin:/sbin"
