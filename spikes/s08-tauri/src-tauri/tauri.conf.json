{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "s08-app",
  "version": "0.1.0",
  "identifier": "dev.marsa.spike-s08",
  "build": {
    "beforeDevCommand": "pnpm run prepare:sidecar && pnpm run dev",
    "beforeBuildCommand": "pnpm run prepare:sidecar && pnpm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Marsa · S-08 spike",
        "width": 820,
        "height": 760,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/s08-sidecar"],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
